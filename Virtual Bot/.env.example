# Virtual Bot — every secret it reads, with no values.
#
# Copy to `.env` next to this file and fill in what you use. Secrets live
# ONLY in the environment: config.yaml, the code and the repo hold none.
# app_config.py loads this `.env` (and the repo-root one) at start-up; a real
# `export` wins over the file. Leave a line empty and that feature stays off.
#
# Before a commit, from the repo root: `gitleaks git --pre-commit --staged`
# (CI scans every commit with .gitleaks.toml on each push).

# ---- Brains ----------------------------------------------------------------
# OpenClaw gateway. A LOCAL gateway's token is read from OpenClaw's own config
# (~/.openclaw/openclaw.json), so this is only for a gateway on another host.
OPENCLAW_TOKEN=
# Omni router (brains.py). Falls back to OpenClaw's env.vars when unset.
OMNI_API_KEY=
# SotaModel, used through the "anthropic" slot — not an official Anthropic key.
ANTHROPIC_API_KEY=
# Local Chat2API; most installs need no key.
CHAT2API_API_KEY=
# Regolo: speech recognition, the image model and the quick Jev tier.
REGOLO_ASR_API_KEY=
REGOLO_BASE_URL=
# The real Jev router (TypeSafe AI). Without it Jev picks by keywords.
TYPESAFE_API_KEY=

# ---- Voice -----------------------------------------------------------------
# Text-to-speech. Without it the bot speaks through Piper.
ELEVENLABS_API_KEY=
# Xiaomi MiMo voice.
MIMO_API_KEY=
MIMO_BASE_URL=

# ---- Music and YouTube transcripts ----------------------------------------
SUPADATA_API_KEY=
TRANSCRIPTAPI_KEY=

# ---- Messengers and Google -------------------------------------------------
# Fallbacks only: a token set from the panel (runtime/integrations/, git-
# ignored) wins. Careful: a TELEGRAM_BOT_TOKEN exported by launchctl belongs
# to OpenClaw's bot, and two pollers on one bot fight with 409 Conflict.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Email -----------------------------------------------------------------
# Agent mailboxes (agent-mail-worker).
AGENT_MAIL_API_URL=
AGENT_MAIL_API_KEY=
AGENT_MAIL_DOMAIN=
# Outgoing mail through Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# ---- Sharing and the tunnel ------------------------------------------------
# site_share.py publishes to Cloudflare: a scoped token, or the global key
# with its account email.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_AUTH_EMAIL=
# Shared secret of tunnel_guard.py.
GUARD_SECRET=

# ---- Sign-in (Clerk) -------------------------------------------------------
# The issuer is also derived from the panels' VITE_CLERK_PUBLISHABLE_KEY.
CLERK_JWT_ISSUER=

# ---- Model benchmark only (bench/run.py) ----------------------------------
OPENROUTER_API_KEY=
# A ZenMux pay-as-you-go key; on a $0 balance only its $0 models answer.
ZENMUX_API_KEY=
