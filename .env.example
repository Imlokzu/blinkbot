# Repo-root .env — keys for the infrastructure around the bot, with no values.
# The bot's own keys are in "Virtual Bot/.env.example".
#
# Copy to `.env` here and fill in what you use. Secrets live ONLY in the
# environment; nothing tracked in git may hold one. Virtual Bot loads this
# file too, after its own .env (its own value wins).

# Hoplite cloud coding agents — REST API (the MCP server signs in with OAuth).
HOPLITE_API_KEY=
# Jules (Google) — read by jules-mcp from the env or the nearest .env.
JULES_API_KEY=

# Cloudflare: Workers, R2 and site sharing.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_KEY=
CLOUDFLARE_AUTH_EMAIL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# Brevo — outgoing mail (API and SMTP relay).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SMTP_SERVER=
BREVO_SMTP_PORT=
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=

# Agent mail gateway (agent-mail-worker). The worker itself gets these as
# `wrangler secret put`, never through wrangler.toml.
AGENT_MAIL_ADMIN_KEY=
AGENT_MAIL_AGENT_TOKEN=
