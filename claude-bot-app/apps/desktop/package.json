{
  "name": "@claude-bot/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron-обгортка: та сама веб-збірка Expo як застосунок для macOS, Windows, Linux",
  "main": "src/main.js",
  "scripts": {
    "dev": "npm run build:web -w @claude-bot/app && node scripts/launch.js",
    "start": "node scripts/launch.js",
    "build": "npm run build:web -w @claude-bot/app && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.imlokzu.claudebot",
    "productName": "Клод Бот",
    "files": [
      "src/**",
      "scripts/**",
      "package.json",
      "branding/**"
    ],
    "extraResources": [
      {
        "from": "../app/dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "branding/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "branding/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "branding/icon.png"
    },
    "directories": {
      "buildResources": "branding"
    }
  }
}
