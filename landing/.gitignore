node_modules
dist
*.local
.DS_Store

# Raw captures before WebP encoding (see scripts/shots/README.md)
scripts/shots/raw

# The root .gitignore drops *.webp as a large binary asset. These are the
# page's own screenshots (about 1.5 MB in all), regenerated by
# scripts/shots/capture.sh and needed to build the page, so keep them.
!public/shots/**/*.webp
